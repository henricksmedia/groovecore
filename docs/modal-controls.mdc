// Efficient parameter updates with throttling
const parameterUpdateQueue = new Map();
let updateScheduled = false;

function scheduleParameterUpdate(instrument, param, value) {
  parameterUpdateQueue.set(`${instrument}-${param}`, value);
  
  if (!updateScheduled) {
    updateScheduled = true;
    requestAnimationFrame(() => {
      processParameterUpdates();
      updateScheduled = false;
    });
  }
}

// Memory management
function disposeUnusedNodes() {
  Object.values(synths).forEach(synth => {
    if (synth.disposed) return;
    
    // Clean up any temporary nodes
    if (synth.tempNodes) {
      synth.tempNodes.forEach(node => node.dispose());
      synth.tempNodes = [];
    }
  });
}
```

